# CryptoPulse backend config. Copy to .env and fill in:  cp .env.example .env
# On a host (Render/Railway/etc.) set these as environment variables instead.

# Port the backend listens on (also serves the dashboard). Hosts usually set this.
PORT=8080

# ---------- LOGIN (server-side auth) ----------
# These never reach the browser and must NOT be committed to the repo.
# Username for the login (default is "admin" if unset).
AUTH_USER=admin
# Password — set ONE of the two below.
#   Simple: plaintext password, kept only here / in the host's env.
AUTH_PASS=
#   Stronger: a scrypt hash so the plaintext isn't stored even in env. Generate with:
#     node -e "const c=require('crypto');const s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync(process.argv[1],s,32).toString('hex'))" "YOUR-PASSWORD"
#   then paste the output here and leave AUTH_PASS blank.
AUTH_PASS_HASH=
# Secret used to sign session cookies. Set a long random value so logins survive
# restarts and can't be forged. Generate with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------- Optional data keys (all optional) ----------
# Real news feed — https://cryptopanic.com/developers/api/
# Without it, the server falls back to the free CryptoCompare feed.
CRYPTOPANIC_TOKEN=

# Real large-transfer / exchange flow data — https://docs.whale-alert.io/
# Without it, the client shows clearly-labelled SAMPLE whale data.
WHALE_ALERT_KEY=

# LLM headline sentiment via Claude — https://console.anthropic.com/
# Without it, the built-in keyword classifier is used.
ANTHROPIC_API_KEY=
